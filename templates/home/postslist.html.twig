{% for postWithUrl in postsWithUrls %}
{# Liste des articles : chaque card est cliquable vers sa page #}
    {% set post = postWithUrl.post %}
    {% if post.status == true %}
        <a href="{{ postWithUrl.url }}">
            <div class="col h-100">
                <div class="card card-profile h-100 p-3">
                    <div class="align-content-center">
                        <h3>{{ post.title|raw }}</h3>
                        {# Aperçu du contenu d'un 'article (100 premiers caractères) #}
                        <p>{{ post.content|striptags|slice(0, 100) }}...</p>
                    </div>
                    <div class="card-body p-0">
                        <div class="row align-items-center">
                            <div class="col-7">
                                Catégorie(s) :
                                {% if post.categories is not empty %}
                                    {% for category in post.categories %}
                                        {% if loop.last %}
                                            {{ category.name }}
                                        {% else %}
                                            {{ category.name }},
                                        {% endif %}
                                    {% endfor %}
                                {% else %}
                                    Aucune catégorie
                                {% endif %}
                            </div>
                            <div class="col-5 d-flex justify-content-end">
                                <div>Commentaire {{ post.commentCounter ?? 0 }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    {% endif %}
{% endfor %}




