{% extends 'base.html.twig' %}
{# => Si displayList = true : afficher la liste des articles #}
{# => Sinon : afficher un article unique (postWithUrls[0]) #}
	{% block title %}
{{ pageTitle|default('Réseau des Semeurs de Jardins') }}
{% endblock %}

	{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/index.css') }}"> 
	<link rel="stylesheet" href="{{ asset('styles/categories_tabs.css') }}">
	<link rel="stylesheet" href="{{ asset('styles/post.css') }}">
{% endblock %}

{% block content %}
	<div class="container-fluid d-flex flex-column main-container-style">
		{% for message in app.flashes('success') %}
			<div class="flash-notice alert alert-success">
				{{ message }}
			</div>
		{% endfor %}
		{% for message in app.flashes('error') %}
			<div class="flash-notice alert alert-danger">
				{{ message }}
			</div>
		{% endfor %}
		<div class="content_home josefinSans">
			<div class="home_picture" style="background-image: url('{{ asset(bannerPath) }}');"></div>

			{# Categories et onglets #}
			{% include '_partials/categories_tabs/categories_tabs.html.twig' %}
			<div class="content_main">
				<div class="d-flex flex-column p-2">	
					{# --- LISTE DES ARTICLES --- #}
					{% if displayList %}
						{% if postsWithUrls|length > 0 %}
							{# breadCrumb : Fil d'ariane en french #}
							{% include '_partials/header/breadcrumb.html.twig' with {'category': category} %}
							<div class="row_index">
								<div class="d-flex justify-content-end me-3">
									{% set orderUrl = categoryId is defined and categoryId is not null and tabPost === false
										? path('app_articles', {'category': categoryId})
										: (slug is defined and slug is not null
											? path('app_home_with_slug', {'slug': slug, 'category': categoryId})
											: path('app_articles')) %}

									<select class="form-select"
											aria-label="Trier les articles"
											style="width: fit-content;"
											onchange="window.location.href='{{ orderUrl }}{{ '?' in orderUrl ? '&' : '?' }}order=' + this.value">
										<option value="ASC" {% if order == 'ASC' %}selected{% endif %}>Du plus ancien au plus récent</option>
										<option value="DESC" {% if order == 'DESC' %}selected{% endif %}>Du plus récent au plus ancien</option>
									</select>
								</div>
								<div id="posts_list">									
									{% for postWithUrl in postsWithUrls %}
										{% set post = postWithUrl.post %}
										<div class="row_index_item mx-lg-4 my-lg-4 p-4 my-2 card card-profile">
											<div class="row_index_item_content">
												<div class="row_index_item_header d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-2">
													<h2 class="mb-0">
														<a href="{{ path('app_home_with_slug', {'slug': post.slug}) }}" class="post-title-link">
															{{ post.title }}
														</a>
													</h2>
													<span class="post-date text-muted">
														{{ post.postedAt|format_datetime(locale: 'fr', pattern: 'd MMMM Y') }}
													</span>
												</div>
												<div class="row_index_item_excerpt">
													{{ post.content|striptags|slice(0, 50)|raw }}...
												</div>
												<div class="row_index_item_footer mt-2">
													<a href="{{ path('app_home_with_slug', {'slug': post.slug, 'category': categoryId, 'postSlug': postSlug}) }}" class="button btn-secondary-outline">
														Lire la suite
													</a>
												</div>
											</div>
										</div>
									{% endfor %}
								</div>
							</div>
						{% else %}
							<div class="text-center py-5">
								<h2>Aucun article disponible</h2>
								<p>Aucun article n'est encore publié pour cette catégorie.</p>
							</div>
						{% endif %}
					{% else %}
						{# --- ARTICLE UNIQUE --- #}
						{% if postsWithUrls|length == 1 %}
							{% set postWithUrl = postsWithUrls[0] %}
							{% set post = postWithUrl.post %}
							{% if backToList %}
								{% if categoryId is defined and categoryId is not null %}
									<div class="mb-3">
										<a href="{{ path('app_articles', {'category': categoryId}) }}" class="button btn-outline-primary">
											<i class="fa-solid fa-arrow-left"></i>
											Retour à la liste
										</a>
									</div>
								{% elseif postSlug is defined and postSlug is not null %}
									<div class="mb-3">
										<a href="{{ path('app_home_with_slug', {'slug': postSlug}) }}" class="button btn-outline-primary">
											<i class="fa-solid fa-arrow-left"></i>
											Retour à la liste
										</a>
									</div>
								{% endif %}
							{% endif %}							
							{# breadCrumb : Fil d'ariane en french #}
							{% include '_partials/header/breadcrumb.html.twig' with {'post': postWithUrl.post} %}
							<div class="post-content row_index">
								<div class="row_index_item single-post">
									<div class="row_index_item_content">
										<div class="row_index_item_header d-flex flex-column flex-md-row justify-content-end align-items-md-center mb-3">
											<span class="post-date text-muted">
												{{ post.postedAt|format_datetime(locale: 'fr', pattern: 'd MMMM Y') }}
											</span>
										</div>
										<div>
											{{ post.content|raw }}
										</div>
									</div>
								</div>

								{# --- COMMENTAIRES --- #}
								{% if commentForm is not null %}
									<div class="comments-section mt-5 container">
										<h3>Commentaires ({{ commentCount }})</h3>

										{% if comments|length > 0 %}
											<div class="comments-list mb-4">
												{% for comment in comments %}
													<div class="comment-item p-3 mb-2 border rounded">
														<div class="comment-header d-flex justify-content-between">
															<span class="badge-team fw-bold">{{ comment.pseudo }}</span>
															<small class="text-muted">
																{{ comment.createdAt|format_datetime(locale: 'fr', pattern: 'd MMMM Y à HH:mm') }}
															</small>
														</div>
														<div class="comment-content mt-2">
															{{ comment.content|nl2br }}
														</div>
													</div>
													 {# Réponses de l'équipe #}
													{% for reply in comment.replies %}
														{% if reply.isApproved %}
															<div class="comment-item p-3 mb-2 border border-3 rounded  ms-3">
																<div class="comment-header d-flex justify-content-between">
																	<span class="badge-team fw-bold">{{ reply.pseudo }}</span>
																	<span class="badge-team fw-bold">Réponse du réseau</span>
																	<small class="text-muted">{{ reply.createdAt|format_datetime(locale: 'fr', pattern: 'd MMMM Y à HH:mm') }}</small>
																</div>
																<div class="comment-content mt-2">
																	{{ reply.content|nl2br }}
																</div>
															</div>
														{% endif %}
													{% endfor %}
												{% endfor %}
											</div>
										{% endif %}

										<div class="comment-form">
											<h4>Laisser un commentaire</h4>
											{{ form_start(commentForm, {'action': path('app_comment_post', {'slug': post.slug})}) }}
											{{ form_widget(commentForm) }}
											<button type="submit" class="button btn-secondary-green mt-2">Publier</button>
											{{ form_end(commentForm) }}
										</div>
									</div>
								{% endif %}
							</div>
						{% else %}
							<div class="text-center py-5">
								<h2>Article introuvable</h2>
								<p>L'article que vous cherchez n'existe pas ou n'est plus disponible.</p>
								<a href="{{ path('app_home') }}" class="button btn-secondary-green">Retour à l'accueil</a>
							</div>
						{% endif %}
					{% endif %}
				</div>
			</div>
		{% endblock %}

		{% block js %}
			<script src="{{ asset('js/index.js') }}" defer></script>
		{% endblock %}
