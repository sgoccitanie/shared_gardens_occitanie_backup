{% extends 'base.html.twig' %}
{# => Si displayList = true : afficher la liste des articles #}
{# => Sinon : afficher un article unique (postWithUrls[0]) #}
	{% block title %}
{{ pageTitle|default('Calendrier | Réseau des Semeurs de Jardins') }}
{% endblock %}

	{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/calendar.css') }}"> <link rel="stylesheet" href="{{ asset('styles/categories_tabs.css') }}">
{% endblock %}

{% block content %}
	<div class="container-fluid d-flex flex-column main-container-style">
		{% for message in app.flashes('success') %}
			<div class="flash-notice alert alert-success">
				{{ message }}
			</div>
		{% endfor %}
		{% for message in app.flashes('error') %}
			<div class="flash-notice alert alert-danger">
				{{ message }}
			</div>
		{% endfor %}
		<div class="content_home josefinSans">
			<div class="home_picture" style="background-image: url('{{ asset(bannerPath) }}');"></div>

			{# Categories et onglets #}
			<div class="d-none d-lg-block h-100">						
				{% include '_partials/categories_tabs/categories_tabs.html.twig' %}
			</div>
			<div class="container-fluid d-lg-none">
				{% include '_partials/categories_tabs/categories_tabs_mobile.html.twig' %}
			</div>

			{% include '_partials/calendar/calendar_events.html.twig' with {'events': events} %}


			<div id="loader" class="position-fixed top-50 start-50 translate-middle d-none loader-container">
				<div class="loader-spinner"></div>
			</div>

			<div id="eventModal" class="modal">
				<div class="modal-content">
					<span class="close">&times;</span>
					<h2 id="modalTitle"></h2>
					<p id="eventContent"></p>
				</div>
			</div>
		</div>
	{% endblock %}
	{% block js %}
		{{ parent() }}
		<script src="{{asset('js/calendar.js')}}" defer></script>
	{% endblock %}
