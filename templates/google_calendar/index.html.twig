{% extends 'base.html.twig' %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/calendar.css') }}">
{% endblock %}

{% block title %}
	Calendrier | Réseau des Semeurs de Jardins
{% endblock %}

{% block content %}
	<div class="container main-container-style main-container-style pt-5">
		<h2 class="text-center kgSecondChancesSolid pb-lg-5">Calendrier des événements et formations</h2>

		{% if error is defined %}
			<div class="alert alert-warning">
				{{ error }}
			</div>
		{% endif %}

		<div class="row pb-lg-5">
			<div class="col-lg-8">
				{% if calendarList|length > 0 %}
					<div id="calendar" class="mx-4"></div>
				{% else %}
					<iframe src="https://calendar.google.com/calendar/embed?src=semeursdejardinslr@gmail.com&ctz=Europe/Paris" style="border: 0" width="800" height="600" frameborder="0" scrolling="no"></iframe>
				{% endif %}
			</div>

			<div class="col-lg-4 mt-3 mt-lg-0 eventsCard">
				{% include '_partials/calendar/calendar_events.html.twig' with {'events': events} %}
			</div>
		</div>
	</div>

	<div id="loader" class="position-absolute top-50 start-50 translate-middle d-none">
		<i class="fa-solid fa-spinner"></i>
	</div>

	<div id="eventModal" class="modal">
		<div class="modal-content">
			<span class="close">&times;</span>
			<h2 id="modalTitle"></h2>
			<p id="eventContent"></p>
		</div>
	</div>
{% endblock %}

{% block js %}
	<script src="{{ asset('js/main.js') }}" defer></script>

	{% if calendarList|length > 0 %}
		{# Charger FullCalendar dans l'ordre #}
		<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.11/locales-all.global.min.js"></script>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
const calendarEl = document.getElementById("calendar");
if (! calendarEl) 
return;



const calendar = new FullCalendar.Calendar(calendarEl, {
locale: "fr",
timeZone: "Europe/Paris",
events: [{% for event in calendarList %}{
publicId: "{{ event.id }}",
title: "{{ event.summary|e('js') }}",
start: "{{ event.start.dateTime|e('js') }}",
end: "{{ event.end.dateTime|e('js') }}",{% if event.colorId == 3 %}color : "rgb(153, 205, 71)",
{% elseif event.colorId == 6 %}
color : "rgb(255, 193, 7)",
{% else %}
color : "rgb(48, 175, 133)",{% endif %}
}
{% if not loop.last %},{% endif %}{% endfor %}],
headerToolbar: {
start: "title",
center: "dayGridMonth, timeGridDay",
end: "prev,next today"
},
eventClick: function (info) {
openModal(info.event.extendedProps.publicId);
}
});

calendar.render();
});

function openModal(id) {
const modal = document.getElementById('eventModal');
const modalTitle = document.getElementById('modalTitle');
const modalContent = document.getElementById('eventContent');
const loading = document.getElementById('loader');

let xhr = new XMLHttpRequest();
loading.classList.remove('d-none');

xhr.open('GET', '/google/calendar/event/' + id, true);

xhr.onload = function () {
loading.classList.add('d-none');
if (xhr.status === 200) {
let event = JSON.parse(xhr.responseText);
modalTitle.textContent = event.summary;

modalContent.textContent = (event.description ? event.description + '<br>' : '') + (event.location ? event.location + '<br>' : '') + (event.start.dateTime ? new Date(event.start.dateTime).toLocaleString('fr-FR', {
day: '2-digit',
month: '2-digit',
year: 'numeric',
hour: '2-digit',
minute: '2-digit'
}) + '<br>' : '') + (event.end.dateTime ? new Date(event.end.dateTime).toLocaleString('fr-FR', {
day: '2-digit',
month: '2-digit',
year: 'numeric',
hour: '2-digit',
minute: '2-digit'
}) : '') + `<div class="d-flex justify-content-end">
                                <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=${
encodeURIComponent(event.summary)
}&dates=${
encodeURIComponent(event.start.dateTime)
}/${
encodeURIComponent(event.end.dateTime)
}&details=${
encodeURIComponent(stripHtml(stripHtml(event.description)))
}&location=${
encodeURIComponent(event.location || '')
}" target="_blank">
                                    <i class="fa-solid fa-calendar-plus"></i>
                                </a>
                            </div>`;
} else {
modalContent.innerHTML = 'Erreur : ' + xhr.status;
} modal.classList.add('d-block');
};

xhr.onerror = function () {
loading.classList.add('d-none');
console.log("Erreur AJAX");
};

xhr.send();
}

document.getElementById('eventModal').addEventListener('click', function (e) {
if (e.target === this) {
this.classList.remove('d-block');
}
});

function stripHtml(html) {
let tmp = document.createElement("DIV");
tmp.innerHTML = html;
return tmp.textContent || tmp.innerText || "";
}
		</script>
	{% endif %}
{% endblock %}
