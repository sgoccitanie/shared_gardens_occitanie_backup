{% extends 'base.html.twig' %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/calendar.css') }}">
{% endblock %}

{% block title %}
	Calendrier | Réseau des Semeurs de Jardins
{% endblock %}

{% block content %}
	<div class="container main-container-style main-container-style pt-5">
		<h2 class="text-center kgSecondChancesSolid pb-lg-5">Calendrier des événements et formations</h2>

		{% if error is defined %}
			<div class="alert alert-warning">
				{{ error }}
			</div>
		{% endif %}

		<div class="row pb-lg-5">
			<div class="col-lg-8">
				{% if calendarList|length > 0 %}
					<div id="calendar" class="mx-4"></div>
				{% else %}
					<iframe src="https://calendar.google.com/calendar/embed?src=semeursdejardinslr@gmail.com&ctz=Europe/Paris" style="border: 0" width="800" height="600" frameborder="0" scrolling="no"></iframe>
				{% endif %}
			</div>

			<div class="col-lg-4 mt-3 mt-lg-0 eventsCard">
				{% include '_partials/calendar/calendar_events.html.twig' with {'events': events} %}
			</div>
		</div>
	</div>

	<div id="loader" class="position-fixed top-50 start-50 translate-middle d-none loader-container">
		<div class="loader-spinner"></div>
	</div>

	<div id="eventModal" class="modal-custom">
		<div class="modal-custom-content">
			<button class="modal-custom-close close" aria-label="Fermer">&times;</button>
			<h2 id="modalTitle" class="modal-custom-title"></h2>
			<div id="eventContent" class="modal-custom-body"></div>
		</div>
	</div>
{% endblock %}

{% block js %}
	<script src="{{ asset('js/main.js') }}" defer></script>

	{% if calendarList|length > 0 %}
		{# Charger FullCalendar dans l'ordre #}
		<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.11/locales-all.global.min.js"></script>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
const calendarEl = document.getElementById("calendar");
if (! calendarEl) 
return;



const calendar = new FullCalendar.Calendar(calendarEl, {
locale: "fr",
timeZone: "Europe/Paris",

// Limite l'affichage à 3 événements par jour, ajoute "+X autres"
dayMaxEvents: 3,

// Affichage plus compact
eventDisplay: 'block',

// Vue initiale mobile/desktop
initialView: window.innerWidth < 768 ? 'listWeek' : 'dayGridMonth',

events: [{% for event in calendarList %}{
publicId: "{{ event.id }}",
title: "{{ event.summary|e('js') }}",
start: "{{ event.start.dateTime|e('js') }}",
end: "{{ event.end.dateTime|e('js') }}",{% if event.colorId == 3 %}color : "rgb(153, 205, 71)",
{% elseif event.colorId == 6 %}
color : "rgb(255, 193, 7)",
{% else %}
color : "rgb(48, 175, 133)",{% endif %}
}
{% if not loop.last %},{% endif %}{% endfor %}],

headerToolbar: {
start: "title",
center: "dayGridMonth,listWeek",
end: "prev,next today"
},

// Textes en français
buttonText: {
today: "Aujourd'hui",
month: 'Mois',
week: 'Semaine',
day: 'Jour',
list: 'Liste'
},

// Texte "+ X autres" en français
moreLinkText: function (n) {
return '+ ' + n + ' autres';
},

// Affichage clic sur "+ X autres"
moreLinkClick: 'popover',

// Clic sur événement
eventClick: function (info) {
openModal(info.event.extendedProps.publicId);
},

// Format heure sans "am/pm"
eventTimeFormat: {
hour: '2-digit',
minute: '2-digit',
hour12: false
}
});

calendar.render();
});

function openModal(id) {
const modal = document.getElementById('eventModal');
const modalTitle = document.getElementById('modalTitle');
const modalContent = document.getElementById('eventContent');
const loading = document.getElementById('loader');

loading.classList.remove('d-none');

fetch('/google/calendar/event/' + encodeURIComponent(id)).then(response => {
if (!response.ok) 
throw new Error('Erreur ' + response.status);



return response.json();
}).then(event => {
loading.classList.add('d-none');
modalTitle.textContent = event.summary;

// Contenu sécurisé (textContent puis ajout HTML dans un conteneur)
const container = document.createElement('div');

if (event.description) {
const desc = document.createElement('p');
desc.innerHTML = event.description;
container.appendChild(desc);
}

if (event.location) {
const loc = document.createElement('p');
loc.innerHTML = '<i class="fa-solid fa-location-dot"></i> ';
loc.appendChild(document.createTextNode(event.location));
container.appendChild(loc);
}

if (event.start.dateTime) {
const dates = document.createElement('p');
dates.innerHTML = '<i class="fa-solid fa-clock"></i> ';
const startDate = new Date(event.start.dateTime).toLocaleString('fr-FR', {
day: '2-digit',
month: '2-digit',
year: 'numeric',
hour: '2-digit',
minute: '2-digit'
});
const endDate = new Date(event.end.dateTime).toLocaleString('fr-FR', {
day: '2-digit',
month: '2-digit',
year: 'numeric',
hour: '2-digit',
minute: '2-digit'
});
dates.appendChild(document.createTextNode(startDate + ' - ' + endDate));
container.appendChild(dates);
}

// Lien Ajouter à mon agenda
if (event.start.dateTime) {
const linkContainer = document.createElement('div');
linkContainer.className = 'd-flex justify-content-end mt-3';

const link = document.createElement('a');
link.href = 'https://calendar.google.com/calendar/render?action=TEMPLATE' + '&text=' + encodeURIComponent(event.summary || '') + '&dates=' + encodeURIComponent(event.start.dateTime || '') + '/' + encodeURIComponent(event.end.dateTime || '') + '&details=' + encodeURIComponent(event.description || '').replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '') + encodeURIComponent((event.description || '').replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '')) + '&location=' + encodeURIComponent(event.location || '');
link.target = '_blank';
link.rel = 'noopener noreferrer';
link.className = 'btn btn-outline-primary btn-sm';
link.innerHTML = '<i class="fa-solid fa-calendar-plus"></i> Ajouter à mon agenda';

linkContainer.appendChild(link);
container.appendChild(linkContainer);
}
modalContent.innerHTML = '';
modalContent.appendChild(container);

modal.classList.add('d-block');
}).catch(error => {
loading.classList.add('d-none');
modalContent.innerHTML = '<p class="text-danger">Erreur lors du chargement.</p>';
modal.classList.add('d-block');
console.error(error);
});
}

document.getElementById('eventModal').addEventListener('click', function (e) {
if (e.target === this) {
this.classList.remove('d-block');
}
});

// Fermeture avec la croix
document.querySelector('#eventModal .close') ?. addEventListener('click', function () {
document.getElementById('eventModal').classList.remove('d-block');
});

// Fermeture avec Échap
document.addEventListener('keydown', function (e) {
if (e.key === 'Escape') {
document.getElementById('eventModal').classList.remove('d-block');
}
});

function stripHtml(html) {
if (! html) 
return '';



const tmp = document.createElement("DIV");
tmp.textContent = html;
return tmp.textContent || tmp.innerText || "";
}
		</script>
	{% endif %}
{% endblock %}
