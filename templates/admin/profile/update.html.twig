{% extends 'base.html.twig' %}

{% block title %}
	Gestion du profil | Réseau SDJ
{% endblock %}

{% block content %}

	<div class="container-fluid d-flex flex-column mt-lg-3">
		<div class="content_main">
			{% for message in app.flashes('success') %}
				<div class="flash-notice alert alert-success">
					{{ message }}
				</div>
			{% endfor %}
			{% for message in app.flashes('error') %}
				<div class="flash-notice alert alert-danger">
					{{ message }}
				</div>
			{% endfor %}
			{# Administrator page Content #}
			<div class="content_dashboard josefinSans">
				{{ form_start(form, { 'attr': { 'class': 'form' }, 'method': 'POST', 'action': path('app_admin_profile_update') }) }}
					<div class="previous-page">
						<a href="{{ path('app_admin_profile') }}" class="nav-link py-lg-4 mb-4"><img src="{{asset('img/icons/previous.png')}}" class="previous-icon" alt="Retour icône">Retour au profil</a>
					</div>
				{{form_row(form.login)}}
				{{form_row(form.firstname)}}
				{{form_row(form.lastname)}}
				{# Password #}
				<div class="my-4 pt-3">
					<h5 class="mb-3 text-muted">Changer le mot de passe</h5>
					<div class="mb-3 mx-5">
						{{ form_row(form.plainPassword.first) }}
					</div>
					<div class="mx-5">
						{{ form_row(form.plainPassword.second) }}
					</div>
				</div>

				<div class="py-2 mt-4">
					{{ form_row(form.submit) }}
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
