{# Éditeur complet pour créer un article par l'admin : TinyMCE pour le texte riche, les images via upload, les PDFs via plugin drag & drop #}
{% extends '@EasyAdmin/crud/form_theme.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
    .pdf-embed {
        min-height: 600px;
        display: block;
    }

    .pdf-embed object {  /* Utiliser <object> => plus fiable que <iframe> */
        width: 100%;
        height: 1200px;
        display: block;
        border: none !important;
    }
    </style>
{% endblock %}

{% block _Posts_content_widget %}
    {{ tinymce_scripts() }}
    <textarea name="Posts[content]" id="{{ id }}" class="tinymce" role="textbox" style="background-red">{{ data }}</textarea>

    <script>
        tinymce.PluginManager.add('pdf', function(editor) {
            editor.ui.registry.addButton('pdf', {
                text: 'PDF',
                icon: 'insert-file',
                tooltip: 'Insérer un PDF',
                // Clic sur bouton PDF ou glisser-déposer
                onAction: function() {
                    let input = document.createElement('input');
                    input.type = 'file';
                    input.accept = '.pdf';
                    input.onchange = function() {
                        let file = this.files[0];
                        if (!file) return;

                        let formData = new FormData();
                        formData.append('file', file);

                        fetch('{{ path('api_tinymce_upload_file') }}', {
                            method: 'POST',
                            body: formData,
                        })
                        .then(response => response.json())
                        .then(function(jsonData) {
                            if (jsonData.error) {
                                alert(jsonData.error);
                            } else if (jsonData.location) {
                                let pdfUrl = jsonData.location;
                                // 1. Insérer avec le bouton "PDF" de TinyMCE
                                // Utiliser <object> => plus fiable que <iframe>  => ~hauteur A4 + marge  (Pour le moment : !vue )
                                const pdfHtml = '<div class="pdf-embed" style="width:100%; height:1123px; margin:1rem 0;">' +
                                    '<object data="' + pdfUrl + '" type="application/pdf" style="width:100%; height:100%; border:none;">' +
                                    'Votre navigateur ne supporte pas les PDFs. <a href="' + pdfUrl + '">Télécharger le PDF</a>' +
                                    '</object></div>';
                                editor.insertContent(pdfHtml);
                            }
                        })
                        .catch(error => {
                            alert('Erreur : ' + error.message);
                        });
                    };
                    input.click();
                }
            });
        });

        tinymce.init({
            selector: '.tinymce',
            license_key: 'gpl',
            base_url: '/bundles/tinymce/ext/tinymce/',
            relative_urls: false,
            remove_script_host: false,
            // Désactiver TOUTE modification du HTML
            cleanup_on_startup: false,
            trim_span_elements: false,
            entity_encoding: 'raw',
            forced_root_block: '',
            forced_root_block_attrs: {},
            // Autoriser TOUTES les balises et attributs (y compris <object>)
            valid_elements: '*[*]',
            valid_children: '+body[*]',
            extended_valid_elements: '*[*]',
            verify_html: false,
            cleanup: false,
            plugins: ["link", "image", "pdf", "code"],
            toolbar: [
                "cut copy | undo redo | bold italic strikethrough underline | forecolor backcolor | blockquote | removeformat | pdf | link image | code",
                "formatselect | alignleft aligncenter alignright alignjustify | bullist numlist | outdent indent"
            ],
            height: 1000,
            link_default_target: '_blank',
            images_upload_url: '{{ path('api_tinymce_upload_image') }}',
            images_upload_handler: function (blobInfo, success, failure) {
                let formData = new FormData();
                formData.append('file', blobInfo.blob(), blobInfo.filename());
                fetch('{{ path('api_tinymce_upload_image') }}', {
                    method: 'POST',
                    body: formData,
                })
                .then(response => response.json())
                .then(function(jsonData) {
                    if (jsonData.location) {
                        success(jsonData.location);
                    } else {
                        failure('Réponse inattendue du serveur.');
                    }
                })
                .catch(error => { failure('Erreur : ' + error.message); });
            },
            setup: function(editor) {
                editor.on('BeforeSetContent', function(e) {
                    // Ne pas modifier le contenu
                    e.content = e.content;
                });
                editor.on('PostProcess', function(e) {
                    // Ne pas modifier le contenu
                    e.content = e.content;
                });
                editor.on('dragend', function(e) { e.preventDefault(); });
                editor.on('dragover', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    editor.getBody().style.backgroundColor = '#eee';
                });
                editor.on('dragleave', function(e) {
                    e.preventDefault();
                    editor.getBody().style.backgroundColor = '';
                });
                editor.on('drop', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    editor.getBody().style.backgroundColor = '';
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        const file = files[0];
                        const isImage = file.type.startsWith('image/');
                        const isPdf = file.type === 'application/pdf';
                        if (isImage || isPdf) {
                            let formData = new FormData();
                            formData.append('file', file);
                            let url = isImage ? '{{ path('api_tinymce_upload_image') }}' : '{{ path('api_tinymce_upload_file') }}';
                            fetch(url, { method: 'POST', body: formData })
                            .then(response => response.json())
                            .then(function(jsonData) {
                                if (jsonData.error) { alert(jsonData.error); }
                                else if (jsonData.location) {
                                    if (isImage) {
                                        editor.insertContent('<img src="' + jsonData.location + '" alt="' + file.name + '">');
                                    } else {
                                        let pdfUrl = jsonData.location;
                                        // 2. Insérer un pdf avec glisser-déposer
                                        const pdfHtml = '<div class="pdf-embed" style="width:100%; height:1123px; margin:1rem 0;">' +
                                            '<object data="' + pdfUrl + '" type="application/pdf" style="width:100%; height:100%; border:none;">' +
                                            'Votre navigateur ne supporte pas les PDFs. <a href="' + pdfUrl + '">Télécharger le PDF</a>' +
                                            '</object></div>';
                                        editor.insertContent(pdfHtml);
                                    }
                                }
                            })
                            .catch(error => { alert('Erreur : ' + error.message); });
                        } else {
                            alert('Seuls les fichiers images (JPEG, JPG, PNG, GIF) et PDF sont autorisés.');
                        }
                    }
                });
            },
            init_instance_callback: function(editor) {
                editor.on('LoadContent', function() {
                    const content = editor.getContent();
                    editor.setContent(content, { format: 'raw' });
                });
            }
        });
    </script>
{% endblock %}