{% extends '@EasyAdmin/crud/form_theme.html.twig' %}
{# Éditeur pour créer un article #}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/post.css') }}">
{% endblock %}

{% block _Posts_content_widget %}
    <script src="{{ asset('bundles/tinymce/ext/tinymce/tinymce.min.js') }}"></script>
    <textarea name="Posts[content]" id="{{ id }}" class="tinymce" role="textbox" style="background-red">{{ data }}</textarea>

    <script>
        /* Message (succès ou erreur) dans un conteneur .pdf-embed */
        function showPdfMessage(pdfEmbedElement, messageText, isSuccess) {
            // Vérifier que le conteneur contient un iframe
            const iframe = pdfEmbedElement.querySelector('iframe');
            if (!iframe) return;

            // Supprimer les messages existants (succès ou erreur)
            const existingMessage = pdfEmbedElement.querySelector('.pdf-validation-message, .pdf-error-message');
            if (existingMessage) {
                // Annuler le timeout existant avant de supprimer le message
                if (existingMessage.dataset.timeoutId) {
                    clearTimeout(parseInt(existingMessage.dataset.timeoutId));
                }
                existingMessage.remove();
            }

            // Créer le message
            const message = document.createElement('div');
            message.className = isSuccess ? 'pdf-validation-message' : 'pdf-error-message';

            // Messages : bleu (succès), rouge (erreur)
            const backgroundColor = isSuccess ? '#d1ecf1' : '#f8d7da';
            const textColor = isSuccess ? '#0d6efd' : '#dc3545';
            const borderColor = isSuccess ? '#0dcaf0' : '#f5c6cb';

            message.innerHTML = `
                <div style="
                    width: 100%;
                    text-align: center;
                    background-color: ${backgroundColor};
                    color: ${textColor};
                    padding: 8px;
                    font-size: 16px;
                    font-weight: bold;
                    border-top: 2px solid ${borderColor};
                    box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.1);
                ">${messageText}</div>
            `;

            // Placer le message en bas du conteneur
            pdfEmbedElement.appendChild(message);

            // Stocker le timeout
            const timeoutId = setTimeout(() => {
                if (message && message.parentNode) {
                    message.remove();
                }
            }, 8000); // Message affiché pendant 8 secondes
            message.dataset.timeoutId = timeoutId;
        }
        // Plugin TinyMCE pour gérer l'insertion de PDF
        tinymce.PluginManager.add('pdf', function(editor) {
            editor.ui.registry.addButton('pdf', {
                text: 'PDF',
                icon: 'insert-file',
                tooltip: 'Insérer un PDF',
                onAction: function() {
                    // Créer un input file pour sélectionner un PDF
                    let input = document.createElement('input');
                    input.type = 'file';
                    input.accept = '.pdf';
                    input.onchange = function() {
                        let file = this.files[0];
                        if (!file) return;

                        // Préparer la requête pour uploader le PDF
                        let formData = new FormData();
                        formData.append('file', file);

                        fetch('{{ path('api_tinymce_upload_file') }}', {
                            method: 'POST',
                            body: formData,
                        })
                        .then(response => response.json())
                        .then(function(jsonData) {
                            if (jsonData.error) {
                                alert(jsonData.error);

                            } else if (jsonData.location) {
                                
                                // Insérer le PDF dans l'éditeur
                                let pdfUrl = jsonData.location;
                                const pdfHtml = '<div class="pdf-embed" style="width:100%; height:1122px; margin:1rem 0;" data-mce-fragment="1">' +
                                    '<iframe src="' + pdfUrl + '" width="100%" height="1122px" style="border:none;" allowfullscreen data-mce-fragment="1"></iframe>' +
                                    '</div>';
                                editor.insertContent(pdfHtml);

                                // Attendre que TinyMCE finisse de traiter le contenu
                                setTimeout(() => {
                                    const pdfEmbeds = editor.getBody().querySelectorAll('.pdf-embed:not(:has(.pdf-validation-message, .pdf-error-message))');
                                    pdfEmbeds.forEach(embed => {
                                        showPdfMessage(embed, '✓ PDF validé - Vous pouvez sauvegarder.', true);
                                    });
                                }, 100);
                            }
                        })
                        .catch(error => {
                            alert('Erreur : ' + error.message);
                        });
                    };
                    input.click();
                }
            });
        });

        //* Initialisation de TinyMCE *//
        tinymce.init({
            elementpath: false, // Désactiver les div en bas de l'éditeur
            selector: '.tinymce',
            license_key: 'gpl',
            content_css: [
                '{{ asset('styles/post.css') }}'
            ],
            body_class: 'post-content',
            language: 'fr_FR',
            base_url: '/bundles/tinymce/ext/tinymce/',
            /* URLs et liens */
            relative_urls: false,
            remove_script_host: false,
            link_default_target: '_blank',
            /* Nettoyer le HTML / Valider */
            extended_valid_elements: 'object[data|type|width|height|style],param[name|value],iframe[src|width|height|style|frameborder|allowfullscreen]',
            allow_html_in_named_anchor: true,
            allow_conditional_comments: false,
            allow_script_urls: false,
            allow_svg: true,
            /* Désactiver le nettoyage automatique du HTML */
            cleanup_on_startup: false,
            trim_span_elements: false,
            entity_encoding: 'raw',
            valid_elements: '*[*]',
            valid_children: '+body[*]',
            extended_valid_elements: '*[*]',
            verify_html: false,
            cleanup: false, // Désactiver le nettoyage automatique
            plugins: [
                "link", "image", "lists", "advlist", "autolink", "charmap", "anchor",
                "searchreplace", "visualblocks", "code", "fullscreen", "insertdatetime",
                "media", "table", "help", "wordcount"
            ],

            /* Plugins et barre d'outils */
            toolbar: 'undo redo | bold italic underline fontfamily fontsize| ' +
                    ' block_formats styles forecolor backcolor  |' +
                    'alignleft aligncenter alignright alignjustify | ' +
                    'bullist numlist | ' +
                    'link image pdf | removeformat | code',

            // Ajouter des styles personnalisés            

            link_default_target: '_blank',
            font_family_formats:
                "Police du site (Josefin Sans)='Josefin Sans', sans-serif;" +
                "Arial=arial, helvetica, sans-serif;" +
                "Georgia=georgia, serif;" +
                "Times New Roman=times new roman, times, serif;" +
                "Verdana=verdana, geneva, sans-serif",

            font_size_formats: '10px 12px 14px 16px 18px 20px 24px 32px 36px',

            content_style: "body { font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; } " +
                           ".text-center { text-align: center; } " +
                           ".color-green { color: #99cd47; } " +
                           ".lead { font-size: 1.25rem; font-weight: 300; } " +
                           "h2 { color: #99cd47; font-size: 2rem; margin-bottom: 1rem; } " +
                           "p { margin-bottom: 1rem; }",
            //couleurs par défaut du sélecteur TinyMCE
            color_map: [
                '99CD47', 'Vert Semeurs',
                '7FBF3A', 'Vert foncé',
                'D4E8B0', 'Vert clair',
                '30AF85', 'Turquoise',
                'E6007E', 'Rose charte',
                '333333', 'Texte',
                '666666', 'Texte clair',
                'FFFFFF', 'Blanc',
            ],
            style_formats_merge: false,
            style_formats: [
                { title: 'Titre 1', block: 'h1' },
                { title: 'Titre 2', block: 'h2' },
                { title: 'Titre 3', block: 'h3' },
                { title: 'Paragraphe', block: 'p' },
                { title: 'Block', block: 'div' },
                { title: 'Image responsive', selector: 'img', classes: 'img-fluid' },
                { title: 'Image centrée', selector: 'img', styles: { display: 'block', marginLeft: 'auto', marginRight: 'auto' } },
                { title: 'Image flottante à gauche', selector: 'img', styles: { float: 'left', marginRight: '15px' } },
                { title: 'Image flottante à droite', selector: 'img', styles: { float: 'right', marginLeft: '15px' } },
                { title: 'Bouton', selector: 'a', classes: 'btn btn-secondary-green' },
                { title: 'Citation', block: 'blockquote', styles: { 'border-left': '3px solid black', 'padding-left': '15px', 'font-style': 'italic' } },
            ],
            // laisse accès au sélecteur libre
            custom_colors: true,       
            color_cols: 4,

            /* Interface */
            height: 1000,

            /* Uploads d'images */
            images_upload_url: '{{ path('api_tinymce_upload_image') }}',
            paste_data_images: true,
            object_resizing: true,
            images_upload_handler: async function (blobInfo, progress) {
                try {
                    const formData = new FormData();
                    formData.append('file', blobInfo.blob(), blobInfo.filename());
                    
                    const response = await fetch('{{ path('api_tinymce_upload_image') }}', {
                        method: 'POST',
                        body: formData,
                    });
                    
                    if (!response.ok) throw new Error('Upload failed');
                    
                    const data = await response.json();
                    return data.location;
                } catch (error) {
                    console.error(error);
                    throw new Error('Erreur lors de l\'upload de l\'image');
                }
            },

            // Lazy loading des images insérées
            image_advtab: true,

            /* Gestion du copier-coller des PDF */
            setup: function(editor) {
                editor.on('change', function () {
                    editor.save(); // sync avec le champ hidden
                });
                editor.on('init', function() {
                    const form = editor.getElement().closest('form');
                    if (form) {
                        form.addEventListener('submit', function() {
                            editor.setDirty(false);
                            localStorage.removeItem('draft_' + window.location.pathname);
                        });
                    }
                });
                // Auto-save toutes les 30s
                let saveTimer;
                editor.on('input', function () {
                    clearTimeout(saveTimer);
                    saveTimer = setTimeout(() => {
                        editor.save();
                        localStorage.setItem('draft_' + window.location.pathname, editor.getContent());
                    }, 30000);
                });
                // Restaurer le brouillon
                const draft = localStorage.getItem('draft_' + window.location.pathname);
                if (draft && !editor.getContent()) {
                    if (confirm('Un brouillon est disponible. Le restaurer ?')) {
                        editor.setContent(draft);
                    }
                }
                // Écouteur pour le copier-coller de PDF
                editor.on('PastePostProcess', function(e) {
                    // Vérifier si le contenu collé contient un iframe avec un PDF
                    if (e.node && e.node.innerHTML.includes('<iframe') && e.node.innerHTML.includes('.pdf')) {
                        setTimeout(() => {
                            const pdfEmbeds = editor.getBody().querySelectorAll('.pdf-embed:not(:has(.pdf-validation-message, .pdf-error-message))');
                            pdfEmbeds.forEach(embed => {
                                // Vérifier si l'iframe a une source PDF valide
                                const iframe = embed.querySelector('iframe[src$=".pdf"], iframe[src*="uploads/"]');
                                if (iframe && iframe.src) {
                                    showPdfMessage(embed, '✓ PDF validé - Vous pouvez sauvegarder.', true); // Succès
                                } else {
                                    showPdfMessage(embed, 'Upload du PDF non abouti. Veuillez vérifier le format.', false); // Échec
                                }
                            });
                        }, 100);
                    }
                });

                //* Écouteurs pour le drag & drop *//
                editor.on('BeforeSetContent', function(e) { e.content = e.content; });
                editor.on('PostProcess', function(e) { e.content = e.content; });
                editor.on('dragover', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    editor.getBody().style.backgroundColor = '#eee';
                });
                editor.on('dragleave', function(e) {
                    e.preventDefault();
                    editor.getBody().style.backgroundColor = '';
                });

                // Gestion du drop (dépôt de fichier)
                editor.on('drop', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    editor.getBody().style.backgroundColor = '';
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        const file = files[0];
                        const isImage = file.type.startsWith('image/');
                        const isPdf = file.type === 'application/pdf';
                        if (isImage || isPdf) {
                            let formData = new FormData();
                            formData.append('file', file);
                            // URL d'upload selon le type de fichier
                            let url = isImage ? '{{ path('api_tinymce_upload_image') }}' : '{{ path('api_tinymce_upload_file') }}';
                            fetch(url, { method: 'POST', body: formData })
                            .then(response => response.json())
                            .then(function(jsonData) {
                                if (jsonData.error) {
                                    alert(jsonData.error);
                                } else if (jsonData.location) {

                                    if (isImage) {
                                        // Insérer une image
                                        editor.insertContent('<img src="' + jsonData.location + '" alt="' + file.name + '">');
                                    } else {
                                        // Sinon insérer un PDF
                                        let pdfUrl = jsonData.location;
                                        const pdfHtml = '<div class="pdf-embed" style="width:100%; height:1122px; margin:1rem 0;" data-mce-fragment="1">' +
                                            '<iframe src="' + pdfUrl + '" width="100%" height="1122px" style="border:none;" allowfullscreen data-mce-fragment="1"></iframe>' +
                                            '</div>';
                                        editor.insertContent(pdfHtml);
                                        // Afficher un message temporaire après insertion
                                        setTimeout(() => {
                                            const pdfEmbeds = editor.getBody().querySelectorAll('.pdf-embed:not(:has(.pdf-validation-message, .pdf-error-message))');
                                            pdfEmbeds.forEach(embed => {
                                                showPdfMessage(embed, '✓ PDF validé - Vous pouvez sauvegarder.', true);
                                            });
                                        }, 100);
                                    }
                                }
                            })
                            .catch(error => alert('Erreur : ' + error.message));
                        } else {
                            alert('Seuls les fichiers images (JPEG, JPG, PNG, GIF) et PDF sont autorisés.');
                        }
                    }
                });
            },

            // Initialisaton de TinyMCE terminée => charger le contenu et afficher le PDF
            init_instance_callback: function(editor) {
                editor.on('LoadContent', function() {
                    const content = editor.getContent();
                    editor.setContent(content, { format: 'raw' });  // Conserver le format brut du contenu
                });
            }
        });
        window.addEventListener('beforeunload', function (e) {
            const editors = tinymce.editors;
            for (let i = 0; i < editors.length; i++) {
                if (editors[i].isDirty()) {
                    e.preventDefault();
                    e.returnValue = '';
                    return '';
                }
            }
        });
    </script>
{% endblock %}