<div id="events" class="container">
	<h3 class="eventTitle">Événements à venir</h3>
	<div class="row row-event">
		{% set lastDisplayedDate = '' %}
		{% for event in events %}
			{# Récupérer la date de début (dateTime ou date) #}
			{% set eventStart = event.start.dateTime ?? event.start.date %}
			{% set eventStartDay = eventStart|date('Y-m-d') %}

			{% if eventStartDay != lastDisplayedDate %}
				{% if eventStartDay == 'now'|date('Y-m-d') %}
					<div class="event-date">Aujourd'hui</div>
				{% else %}
					<div class="event-date">{{ eventStart|format_datetime(locale:'fr', pattern:'EEEE d MMMM') }}</div>
				{% endif %}
				{% set lastDisplayedDate = eventStartDay %}
			{% endif %}

			<div class="eventsList color-{{ event.colorId in [1,3,6] ? event.colorId : 1 }}">
				<div class="container-fluid p-0">
					<div class="row">
						<div class="col">
							<h4>{{ event.summary }}</h4>
						</div>
						<div class="col-3 d-flex justify-content-end fw-bold">
							{% if event.start.dateTime %}
								{{ event.start.dateTime|date('H:i') }}
								-
								{{ event.end.dateTime|date('H:i') }}
							{% else %}
								Journée entière
							{% endif %}
						</div>
					</div>
				</div>
				<p style="font-weight: 600;">
					{{ eventStart|format_datetime(locale:'fr', pattern:'EEEE d MMMM') }}
					{% set eventEnd = event.end.dateTime ?? event.end.date %}
					{% if eventEnd|date('Y-m-d') is not same as(eventStartDay) %}
						-
						{{ eventEnd|format_datetime(locale:'fr', pattern:'d MMMM') }}
					{% endif %}
				</p>
				<p>{{ event.description ? event.description|raw : 'Aucune description.' }}</p>
				<p>{{ event.location ? event.location : '' }}</p>
				<div class="d-flex justify-content-end">
					{% if event.start.dateTime %}
						<a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text={{ event.summary|url_encode }}&dates={{ event.start.dateTime|date('Ymd\\THis') }}/{{ event.end.dateTime|date('Ymd\\THis') }}&details={{ event.description|raw|replace({'<br>': '\n', '<br/>': '\n', '<br />': '\n'})|striptags|url_encode }}&location={{ event.location|url_encode }}" target="_blank">
							<i class="fa-solid fa-calendar-plus"></i>
							Ajouter à mon agenda
						</a>
					{% endif %}
				</div>
			</div>
		{% endfor %}
	</div>
</div>
