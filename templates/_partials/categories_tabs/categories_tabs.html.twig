{% if categoriesWithTabs is defined and categoriesWithTabs|length > 0 %}
	<div class="categories-tabs-container">
		{% for categoryWithTabs in categoriesWithTabs %}
			<div class="category-section">
				{% if categoryWithTabs.categories is not null %}
					{% if categoryWithTabs.categories.id == 2 %}
						{# Catégorie spéciale "À venir" - lien direct #}
						<h3 class="category-title">
							<a href="{{ path('app_coming_soon') }}">
								{{ categoryWithTabs.categories.name }}
							</a>
						</h3>
					{% else %}
						<h3 class="category-title">
							<a href="{{ path('app_articles') }}?category={{ categoryWithTabs.categories.id }}">
								{{ categoryWithTabs.categories.name }}
							</a>
						</h3>
						{% if categoryWithTabs.tabs|length > 0 %}
							<div class="tabs-list">
								{% for tabWithPosts in categoryWithTabs.tabs %}

    								{% set postCount = tabWithPosts.posts|length %}
									{% set singlePost = postCount == 1 ? tabWithPosts.posts|first : null %}
									{% set currentSlug = app.request.attributes.get('slug') %}

									<a href="
										{% if postCount == 1 %}
											{{ singlePost.url }}
										{% elseif postCount > 1 %}
											{{ path('app_home_with_slug', {'slug': tabWithPosts.tab.slug}) }}?category={{ categoryWithTabs.categories.id }}
										{% else %}
											#
										{% endif %}
									"
									class="tab-link{{ tabWithPosts.tab.slug == currentSlug ? ' active' : '' }}"
									title="{{ tabWithPosts.tab.label }}">
										{{ tabWithPosts.tab.label }}
									</a>
								{% endfor %}
							</div>
						{% endif %}
					{% endif %}
				{% endif %}
			</div>
		{% endfor %}
	</div>
{% endif %}
