{# Enregistrer un nouveau réseau #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/form_contact.css') }}">
{% endblock %}

{% block title %}
    Enregistrer un nouveau compte
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="flash-notice alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="flash-notice alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="container-fluid d-flex flex-column main-container-style">
    <div class="container-fluid" style="margin-bottom: 10rem;">

    {{ form_errors(registrationForm) }}

	{{ form_start(registrationForm, {'method': 'POST', 'action': path('admin_registration'), 'attr': { 'class': 'w-75 m-auto'}}) }}
        {# RETOUR TEMPORAIRE AVANT BILAN AVEC JULIE SUR LE DESIGN DU FORMULAIRE #}
    <div class="previous-page">
        {# Ajout du bouton retour #}
        <a href="{{ path('app_home') }}" class="nav-link py-lg-4 py-2"><img src="{{asset('img/icons/previous.png')}}" class="previous-icon" alt="Retour icône">Retour à l'accueil</a>
    </div>
        <h1 class="kgSecondChancesSolid text-center py-5">Enregistrer un nouveau réseau</h1>
        <div class="container-fluid" style="margin-bottom: 10rem;">
            <div class="row">
                <div class="form-group col-sm-6">
                    <label for="email">Email</label>
                    {{ form_widget(registrationForm.email, { 'attr': { 'class': 'form-control py-2 mb-4' } }) }}
                </div>
                <div class="form-group col-sm-6">
                    <label for="login">Login</label>
                    {{ form_widget(registrationForm.login, { 'attr': { 'class': 'form-control py-2 mb-4' } }) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group col-sm-6">
                    <label for="firstname">Prénom</label>
                    {{ form_widget(registrationForm.firstname, { 'attr': { 'class': 'form-control py-2 mb-4' } }) }}
                </div>
                <div class="form-group col-sm-6">
                    <label for="lastname">Nom</label>
                    {{ form_widget(registrationForm.lastname, { 'attr': { 'class': 'form-control py-2 mb-4' } }) }}
                </div>
            </div>
            <div class="form-group">
                <label for="password">Mot de passe</label>
                {{ form_widget(registrationForm.password, { 'attr': { 'class': 'form-control py-2 mb-4' } }) }}
            </div>
            {# Supprimer le champ "roles" pour les non-admins #}
            {# {% if app.user and is_granted('ROLE_ADMIN') %}
                <div class="form-group">
                    <label for="roles">Rôle</label>
                    {{ form_widget(registrationForm.roles, { 'attr': { 'class': 'form-control py-2 mb-4' } }) }}
                </div>
            {% endif %} #}
            <div class="form-group">
                <label for="user_asso">Association</label>
                {{ form_widget(registrationForm.user_asso, { 'attr': { 'class': 'form-control py-2 mb-4' } }) }}
            </div>
            <div class="form-group form-check">
                {{ form_widget(registrationForm.agreeTerms, { 'attr': { 'class': 'form-check-input' } }) }}
                <label class="form-check-label" for="agreeTerms">J'accepte les conditions d'utilisation</label>
            </div>
            <button type="submit" class="button btn-secondary-green my-3 col-lg-2 col-3">S'inscrire</button>
        </div>
    {{ form_end(registrationForm) }}
    </div>
    </div>
{% endblock %}

{% block js %}
    <script src="{{ asset('js/form.js') }}"></script>
{% endblock %}
